<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ArmorOverhaul' Or '$(MSBuildProjectName)' == 'ArmorControl' Or '$(MSBuildProjectName)' == 'CrewListSorter' Or '$(MSBuildProjectName)' == 'RoboticsKJRCompat'">
    <!-- KSP scans every DLL below GameData, including normal obj folders. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\BuildArtifacts\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
